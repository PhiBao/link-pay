# Magic (Embedded wallet + OTP auth)
# Get from https://dashboard.magic.link
NEXT_PUBLIC_MAGIC_API_KEY=pk_live_YOUR_KEY

# Particle Network (Universal Accounts + EIP-7702)
# Get from https://dashboard.particle.network
NEXT_PUBLIC_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_CLIENT_KEY=YOUR_CLIENT_KEY
NEXT_PUBLIC_APP_ID=YOUR_APP_UUID

# RPC URLs — Arbitrum mainnet
NEXT_PUBLIC_ARB_RPC_URL=https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_BLOCKCHAIN_NETWORK=arbitrum
NEXT_PUBLIC_CHAIN_ID=42161
NEXT_PUBLIC_USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# App URL used when backend creates short payment links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gas sponsorship relay (optional) — fund this wallet with Arbitrum ETH to
# sponsor first-time EIP-7702 delegations so users never need to hold ETH.
RELAYER_PRIVATE_KEY=

# Supabase (server-side request state)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional email notifications
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=LinkPay <onboarding@resend.dev>
